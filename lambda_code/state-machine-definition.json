{
  "Comment": "Enchaînement TemplateSubmissionLambda puis ProvisioningLambda",
  "StartAt": "TemplateSubmissionStep",
  "States": {
    "TemplateSubmissionStep": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:000000000000:function:TemplateSubmissionLambda",
      "ResultPath": "$.templateResult",
      "Next": "ProvisioningStep"
    },
    "ProvisioningStep": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:000000000000:function:ProvisioningLambda",
      "InputPath": "$.templateResult.body",
      "End": true
    }
  }
}
